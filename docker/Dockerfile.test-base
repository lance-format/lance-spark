FROM ubuntu:24.04

RUN apt-get update && \
    apt-get install -y --no-install-recommends \
      curl \
      openjdk-17-jdk-headless \
      python3 \
      python3-dev \
      python3-venv \
      python3-pip \
      nodejs npm && \
    apt-get clean && \
    rm -rf /var/lib/apt/lists/*

RUN npm install -g azurite

# MinIO retired the standalone binaries at dl.min.io (that URL now returns HTTP 410) and
# locked down the Docker Hub repo, so lift the server binary out of a quay.io image. Pinned
# to the last community release rather than :latest so image builds stay reproducible, and
# COPY --from picks the right architecture instead of the hard-coded linux-amd64 the download
# used to force.
COPY --from=quay.io/minio/minio:RELEASE.2025-09-07T16-13-09Z /usr/bin/minio /usr/local/bin/minio

RUN python3 -m venv /opt/venv && \
    . /opt/venv/bin/activate && \
    pip install --upgrade pip && \
    pip install pytest pytest-timeout packaging azure-storage-blob boto3

ENV PATH="/opt/venv/bin:$PATH"
ENV SPARK_HOME="/opt/spark"
ENV PYTHONPATH="${SPARK_HOME}/python:${PYTHONPATH}"
ENV PATH="${SPARK_HOME}/sbin:${SPARK_HOME}/bin:${PATH}"

ARG PY4J_VERSION=0.10.9.9

ENV PYTHONPATH="${SPARK_HOME}/python/lib/py4j-${PY4J_VERSION}-src.zip:${PYTHONPATH}"

# Spark is fetched and cached by the host/CI so Docker layer-cache misses
# do not require another download from archive.apache.org.
COPY spark.tgz /tmp/spark.tgz
RUN mkdir -p ${SPARK_HOME} \
    && tar xzf /tmp/spark.tgz --directory ${SPARK_HOME} --strip-components 1 \
    && rm /tmp/spark.tgz
