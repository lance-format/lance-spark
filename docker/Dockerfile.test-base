ARG SPARK_IMAGE
FROM ${SPARK_IMAGE}

USER root

# 3.4 Hub images are JRE-only. Dockerfile.test compiles a Java fixture.
COPY --from=eclipse-temurin:17-jdk-jammy /opt/java/openjdk /opt/java/jdk
# Focal and Jammy node cannot start Azurite.
COPY --from=node:22-bookworm-slim /usr/local/bin/node /usr/local/bin/node
COPY --from=node:22-bookworm-slim /usr/local/lib/node_modules /usr/local/lib/node_modules
RUN ln -sf /usr/local/lib/node_modules/npm/bin/npm-cli.js /usr/local/bin/npm

ENV JAVA_HOME=/opt/java/jdk

RUN apt-get update && \
    apt-get install -y --no-install-recommends \
      curl \
      python3-dev \
      python3-venv \
      python3-pip && \
    apt-get clean && \
    rm -rf /var/lib/apt/lists/*

RUN npm install -g azurite

# dl.min.io is 410 and Docker Hub minio is locked. Copy from quay for the build arch.
COPY --from=quay.io/minio/minio:RELEASE.2025-09-07T16-13-09Z /usr/bin/minio /usr/local/bin/minio

RUN python3 -m venv /opt/venv && \
    . /opt/venv/bin/activate && \
    pip install --upgrade pip && \
    pip install pytest pytest-timeout packaging azure-storage-blob boto3

ENV PATH="${JAVA_HOME}/bin:/opt/venv/bin:${SPARK_HOME}/sbin:${SPARK_HOME}/bin:${PATH}"
# Docker ENV does not expand globs
RUN ln -s "$(ls ${SPARK_HOME}/python/lib/py4j-*-src.zip)" ${SPARK_HOME}/python/lib/py4j-src.zip
ENV PYTHONPATH="${SPARK_HOME}/python:${SPARK_HOME}/python/lib/py4j-src.zip"
