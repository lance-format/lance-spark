FROM ubuntu:24.04

RUN apt-get update && \
    apt-get install -y --no-install-recommends \
      curl \
      openjdk-17-jdk-headless \
      python3 \
      python3-dev \
      python3-venv \
      python3-pip \
      nodejs npm && \
    apt-get clean && \
    rm -rf /var/lib/apt/lists/*

RUN npm install -g azurite

# dl.min.io is 410 and Docker Hub minio is locked. Copy from quay for the build arch.
COPY --from=quay.io/minio/minio:RELEASE.2025-09-07T16-13-09Z /usr/bin/minio /usr/local/bin/minio

RUN python3 -m venv /opt/venv && \
    . /opt/venv/bin/activate && \
    pip install --upgrade pip && \
    pip install pytest pytest-timeout packaging azure-storage-blob boto3

ENV SPARK_HOME="/opt/spark"
ENV PATH="/opt/venv/bin:${SPARK_HOME}/sbin:${SPARK_HOME}/bin:${PATH}"

COPY spark.tgz /tmp/spark.tgz
RUN mkdir -p ${SPARK_HOME} \
    && tar xzf /tmp/spark.tgz --directory ${SPARK_HOME} --strip-components 1 \
    && rm /tmp/spark.tgz
# Docker ENV does not expand globs
RUN ln -s "$(ls ${SPARK_HOME}/python/lib/py4j-*-src.zip)" ${SPARK_HOME}/python/lib/py4j-src.zip
ENV PYTHONPATH="${SPARK_HOME}/python:${SPARK_HOME}/python/lib/py4j-src.zip"
